# 统一换行符为 LF，保证 macOS / Ubuntu / Windows 下脚本与源码一致
* text=auto eol=lf

# Shell 脚本必须使用 LF，否则 Linux 报 bad interpreter
*.sh text eol=lf

# Windows 批处理保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.woff binary
*.woff2 binary
