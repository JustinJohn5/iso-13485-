# 复制为根目录 .env.test，真实配置不提交。用于 tests/RunE2e.py。
APP_ENV=test
LOG_LEVEL=INFO
LOG_DIR=../.local/E2eLogs
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8400
FRONTEND_PORT=5400
CORS_ORIGINS=http://127.0.0.1:5400
DATABASE_URL=mysql+pymysql://测试账号:请替换密码@127.0.0.1:3306/iso13485_codextest?charset=utf8mb4
CONFIG_ENCRYPTION_KEY=请替换为32字节base64密钥
JWT_SECRET=请替换为随机JWT密钥
JWT_EXPIRE_MINUTES=30
UPLOAD_DIR=../.local/E2eStorage
MAX_UPLOAD_SIZE_MB=40
RULE_SET_DIR=./App/Rules
ACCESS_TOKEN_COOKIE_NAME=iso_e2e_access_token
VITE_API_BASE_URL=http://127.0.0.1:8400
E2E_BASE_URL=http://127.0.0.1:5400
E2E_API_BASE_URL=http://127.0.0.1:8400
# 留空使用已安装的 Playwright Chromium；Windows 可填 msedge。
E2E_BROWSER_CHANNEL=
