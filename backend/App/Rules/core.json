{
  "rule_set_id": "iso13485-core",
  "version": "2.0.0",
  "title": "ISO 13485 文件线索预筛规则",
  "standard": "ISO 13485:2016",
  "description": "共用72项条款要求目录；基础文本线索、待补信息及人工边界，不作符合性判定",
  "document_types": [
    {
      "type": "quality_manual",
      "label": "质量手册",
      "clauses": [
        "4.2"
      ],
      "keywords": [
        "质量手册",
        "quality manual"
      ]
    },
    {
      "type": "procedure",
      "label": "程序文件",
      "clauses": [
        "4.2",
        "4.1"
      ],
      "keywords": [
        "程序",
        "procedure",
        "sop"
      ]
    },
    {
      "type": "management_review",
      "label": "管理评审",
      "clauses": [
        "5.6"
      ],
      "keywords": [
        "管理评审",
        "management review"
      ]
    },
    {
      "type": "internal_audit",
      "label": "内部审核",
      "clauses": [
        "8.2"
      ],
      "keywords": [
        "内部审核",
        "internal audit"
      ]
    },
    {
      "type": "risk_management",
      "label": "风险管理",
      "clauses": [
        "7.1"
      ],
      "keywords": [
        "风险管理",
        "risk management"
      ]
    },
    {
      "type": "design_control",
      "label": "设计开发",
      "clauses": [
        "7.3"
      ],
      "keywords": [
        "设计开发",
        "design and development"
      ]
    },
    {
      "type": "purchasing",
      "label": "采购控制",
      "clauses": [
        "7.4"
      ],
      "keywords": [
        "采购",
        "supplier",
        "供应商"
      ]
    },
    {
      "type": "nonconformity",
      "label": "不合格品控制",
      "clauses": [
        "8.3"
      ],
      "keywords": [
        "不合格品",
        "nonconforming"
      ]
    },
    {
      "type": "other",
      "label": "其他体系文件",
      "clauses": [],
      "keywords": []
    }
  ],
  "severities": {
    "critical": {
      "label": "严重",
      "weight": 10,
      "score_cap": 45
    },
    "major": {
      "label": "主要",
      "weight": 5,
      "score_cap": 75
    },
    "minor": {
      "label": "一般",
      "weight": 2
    },
    "observation": {
      "label": "观察",
      "weight": 1
    }
  },
  "rules": [
    {
      "rule_id": "DOC-001",
      "title": "文件应有可识别的编号",
      "clause": "4.2.4",
      "clause_title": "文件控制",
      "severity": "major",
      "document_types": [
        "*"
      ],
      "check": {
        "type": "present",
        "patterns": [
          "(?:文件|文档|document)\\s*(?:编号|号|no\\.?|number)\\s*[:：#-]?\\s*[A-Za-z0-9._/-]{2,}"
        ]
      },
      "rationale": "确认文件标识信息是否出现在可抽取文本中。 字段形式属于项目管理约定。",
      "suggestion": "核对受控文件编号是否清晰且与文件清单一致。",
      "basis_kind": "project",
      "source": "项目文件控制检查约定；对应用户资料4.2.4，字段形式不是标准统一模板"
    },
    {
      "rule_id": "DOC-002",
      "title": "文件应包含版本或修订标识",
      "clause": "4.2.4",
      "clause_title": "文件控制",
      "severity": "major",
      "document_types": [
        "*"
      ],
      "check": {
        "type": "present",
        "patterns": [
          "(?:版本|修订|revision|version)\\s*(?:号|编号|等级|level)?\\s*[:：#-]?\\s*[A-Za-z0-9._/-]+"
        ]
      },
      "rationale": "检查文件修订状态是否可识别。 字段形式属于项目管理约定。",
      "suggestion": "补充当前版本/修订号，并核对更改历史。",
      "basis_kind": "project",
      "source": "项目文件控制检查约定；对应用户资料4.2.4，字段形式不是标准统一模板"
    },
    {
      "rule_id": "DOC-003",
      "title": "文件应体现批准或授权信息",
      "clause": "4.2.4",
      "clause_title": "文件控制",
      "severity": "major",
      "document_types": [
        "*"
      ],
      "check": {
        "type": "present",
        "patterns": [
          "批准|核准|审批|approved by|approval"
        ]
      },
      "rationale": "文本中查找批准相关字段；字段存在不代表签署有效。 字段形式属于项目管理约定。",
      "suggestion": "确认批准人、批准日期及受控发布记录完整。",
      "basis_kind": "project",
      "source": "项目文件控制检查约定；对应用户资料4.2.4，字段形式不是标准统一模板"
    },
    {
      "rule_id": "DOC-004",
      "title": "文件应有生效日期或发布日期",
      "clause": "4.2.4",
      "clause_title": "文件控制",
      "severity": "minor",
      "document_types": [
        "*"
      ],
      "check": {
        "type": "present",
        "patterns": [
          "(?:生效(?:日期)?|发布(?:日期)?|实施日期|effective\\s+date|issue\\s+date)\\s*[:：]?\\s*\\d{4}\\s*[年./-]\\s*\\d{1,2}\\s*[月./-]\\s*\\d{1,2}\\s*日?",
          "\\d{4}\\s*[年./-]\\s*\\d{1,2}\\s*[月./-]\\s*\\d{1,2}\\s*日?\\s*(?:发布|生效|实施)"
        ]
      },
      "rationale": "检查可抽取文本中是否出现常见日期字段。 字段形式属于项目管理约定。",
      "suggestion": "核对生效日期与批准记录、培训安排及旧版回收记录。",
      "basis_kind": "project",
      "source": "项目文件控制检查约定；对应用户资料4.2.4，字段形式不是标准统一模板"
    }
  ]
}
