# ============================================================
# ISO 13485 文件合规校验平台 —— 后端环境变量示例
# 复制为 backend/.env 后按实际环境填写；必填项缺失时后端启动即报错退出。
# 本文件只允许出现示例值，严禁写入真实密钥。
# ============================================================

# ---------- 运行环境 ----------
# 运行环境标识：dev / test / prod（必填）
APP_ENV=dev
# 日志级别：DEBUG / INFO / WARNING / ERROR（必填）
LOG_LEVEL=INFO
# 日志目录，日志按日期轮转（必填）
LOG_DIR=./Logs

# ---------- 服务端口 ----------
# 后端监听地址与端口（必填，1~65535）：本地开发 8300，测试 8400，正式 8500
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8300
# 前端端口，仅用于文档与脚本对齐，后端不监听此端口
FRONTEND_PORT=5300
# 允许跨域的前端来源，多个用英文逗号分隔（必填）：本地 5300，测试 5400，正式 5500
CORS_ORIGINS=http://127.0.0.1:5300

# ---------- 数据库（仅后端可访问，严禁对公网开放） ----------
# MySQL 8.4 连接串；密码含特殊字符时必须 URL 编码（如 # 写作 %23）
DATABASE_URL=mysql+pymysql://iso_user:请替换为数据库密码@127.0.0.1:3406/iso13485?charset=utf8mb4
# 测试环境使用独立测试库，例如 iso13485_codextest
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---------- 部署密钥（必填，严禁使用示例值或默认值） ----------
# 网站配置加密主密钥（Fernet，32 字节 base64），用于加密网页中配置的大模型 API Key。
# 生成方式：python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# 更换后已存密文无法解密，需在网页重新填写 API Key。
CONFIG_ENCRYPTION_KEY=请替换为32字节base64密钥
# JWT 签名密钥，建议 48 字节随机数的十六进制串。
# 生成方式：python -c "import os;print(os.urandom(48).hex())"
JWT_SECRET=请替换为随机JWT密钥
# 登录令牌有效期（分钟）
JWT_EXPIRE_MINUTES=480

# ---------- 文件与规则 ----------
# 上传文件存储目录（必须位于 Web 可执行目录之外，禁止放到静态资源目录）
UPLOAD_DIR=./Storage
# 单文件大小上限（MB），超过即拒绝
MAX_UPLOAD_SIZE_MB=40
# 规则包目录（内置 ISO 13485 规则 JSON 所在目录）
RULE_SET_DIR=./App/Rules

# ---------- 认证 ----------
# 访问令牌 Cookie 名称；接口同时兼容 Authorization: Bearer 方式
ACCESS_TOKEN_COOKIE_NAME=iso_access_token
