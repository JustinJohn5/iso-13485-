# ============================================================
# ISO 13485 文件合规校验平台 —— 前端环境变量示例
# 复制为 frontend/.env.development（本地）、.env.test、.env.production 后填写。
# 前端环境变量会被打包进浏览器产物，严禁写入任何后端密钥、数据库密码或 API Key。
# ============================================================

# 页面标题
VITE_APP_TITLE=ISO 13485 文件合规校验平台

# 后端 API 基址（必填）：本地 8300 / 测试 8400 / 正式 8500
VITE_API_BASE_URL=http://127.0.0.1:8300

# 前端开发服务器端口（仅构建与 dev server 使用，不会暴露给浏览器）
FRONTEND_PORT=5300
